# Exemple uniquement — ne jamais utiliser ces valeurs en production.
# Pour une installation locale fonctionnelle, exécuter : bash scripts/configure-dev.sh
ENVIRONMENT=development
MYSQL_DATABASE=talentrank
MYSQL_USER=talentrank
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
DATABASE_URL=mysql+pymysql://talentrank:REPLACE_WITH_RANDOM_SECRET@mysql:3306/talentrank?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=talentrank-ai
JWT_AUDIENCE=talentrank-web
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
REFRESH_COOKIE_SECURE=false
DEMO_ENABLED=false
DEMO_USER_EMAIL=demo@babetech.example.org
DEMO_ORGANIZATION_SLUG=babetech
DEMO_ALLOW_WRITES=false
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=talentrank
S3_SECRET_KEY=REPLACE_WITH_RANDOM_STORAGE_SECRET
S3_BUCKET=cv-private
S3_SECURE=false
OCR_LANGUAGES=fra+eng
MALWARE_SCAN_ENABLED=false
SEMANTIC_ENABLED=false
ML_SERVICE_URL=http://ml-service:8090
ML_SERVICE_TOKEN=REPLACE_WITH_RANDOM_ML_TOKEN
QDRANT_URL=http://qdrant:6333
CANDIDATE_PORTAL_ENABLED=false
# Avant toute production : certificat HTTPS, CORS HTTPS, antivirus activé,
# paramètres SMTP sûrs, journaux, sauvegardes et audits réalisés.
