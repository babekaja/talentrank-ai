    "test:proof-v21": "node ../../scripts/frontend_proof_ui_v21_check.cjs",
    "test:ui-v24": "node ../../scripts/frontend_v24_check.cjs",
    "test:simple-v26": "node ../../scripts/frontend_simple_v26_check.cjs",
    "test": "ng test --watch=false",
    "test:unit": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
